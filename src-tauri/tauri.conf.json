{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "streandeck-vk02",
  "version": "0.1.0",
  "identifier": "com.admin.streandeck-vk02",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Stream Deck VK02",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "resizable": false,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http: https: asset: http://asset.localhost https://asset.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http: https: asset: http://asset.localhost https://asset.localhost; connect-src 'self' ws://localhost:1420 ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/icon-cache/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Vietnamese", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mas120/streamdeck-vk02/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0NUI4NDlDNEE1NzBFNTYKUldSV0RsZEtuSVJiaElyRTVMYnpFb2xZNUNhVlB4dzdrVkF1V0JCZWpNUUdVb1R6ZHBuWG1SZlkK"
    }
  }
}
